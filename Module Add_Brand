'—оздает список с регионами в €чейке
Sub CreateRegionArea(cell As Range)
    Dim sheet As Worksheet, temp As Range
    Set sheet = ActiveWorkbook.Sheets("тех")
    Set temp = sheet.Range("AJ2")
    Do While temp.Value <> ""
        Set temp = temp.Offset(1, 0)
    Loop
    Set temp = temp.Offset(-1, 0)
    With ActiveSheet.Range(cell, cell.Offset(0, 3))
        .Merge
        .Interior.ColorIndex = 2
        .Borders.Weight = 2
        .Value = "–егионы"
        .HorizontalAlignment = xlCenter
        With .Validation
            .Delete
            .Add xlValidateList, xlValidAlertStop, , "='тех'!$AJ$1:" & temp.Address
        End With
    End With
End Sub

'ѕроверка на наличие выпадающего списка по €чейке
Function HasValidation(cell As Range) As Boolean
    Dim t: t = Null

    On Error Resume Next
    t = cell.Validation.Type
    On Error GoTo 0

    HasValidation = Not IsNull(t)
End Function

Function FindMergedCells(rng As Range) As Collection
    Dim temp As Range, col As New Collection, seen As Object, areaAddress As String
    Set seen = CreateObject("Scripting.Dictionary")
    For Each temp In rng
        If temp.MergeCells Then
            areaAddress = temp.MergeArea.Address
            If Not seen.Exists(areaAddress) Then
                seen.Add areaAddress, True
                col.Add temp.MergeArea
            End If
        End If
    Next temp
    Set FindMergedCells = col
End Function


Sub Add_Region1()
    Dim firstRegionCell As Range, cell As Range
    Set firstRegionCell = ActiveSheet.Cells(9, 9)
    Set cell = firstRegionCell.Offset(1, 0)
    Do While True
       If HasValidation(cell) = False And cell.RowHeight > 10 Then
           Call CreateRegionArea(cell)
           Exit Do
       Else
           Set cell = cell.Offset(1, 0)
       End If
    Loop
End Sub
Sub Delete_Brand1()
   Dim VBProj As Object, VBComp As Object, CodeMod As Object
   Set VBProj = ThisWorkbook.VBProject
   Set VBComp = VBProj.VBComponents("Add_Brand")
   Set CodeMod = VBComp.CodeModule
    Dim intLinesNr As Long
   intLinesNr = CodeMod.CountOfLines
   ''''''''''
   Dim sheetFlow As Worksheet, sheetBrief As Worksheet, sheetSdelka As Worksheet
   Set sheetFlow = ActiveWorkbook.Sheets("FLOW")
   Set sheetBrief = ActiveWorkbook.Sheets("Ѕриф")
   Set sheetSdelka = ActiveWorkbook.Sheets("—ƒ≈Ћ ј")
   
    Dim rightCell As Range, rightCellBase As Range, temp As Range, leftTopCell As Range, rightCol As Long, rightColForFlow As Long, tempStr As String, bottomRow As Long
    Set rightCell = sheetBrief.Cells(3, 8)
    Set rightCellBase = rightCell
   rightColForFlow = sheetFlow.UsedRange.Find("TOTAL").Column
   
    
  rightCol = sheetSdelka.UsedRange.Column
   Set rightCell = rightCell.Offset(6, 1)
   tempStr = sheetBrief.Name & "!" & rightCell.Address(False, False)
   Do While rightCell.Value <> ""
        'FLOW
        For Each temp In sheetFlow.UsedRange
            If InStr(temp.Formula, tempStr) <> 0 Then
                 Set leftTopCell = temp
                 Exit For
            End If
       Next temp
    
        Set temp = leftTopCell.Offset(1, 0)
    
        Do
            Set temp = temp.Offset(1, 0)
        Loop While temp.Formula = ""
    
        bottomRow = temp.Row + 2
    
        sheetFlow.Range(sheetFlow.Cells(leftTopCell.Row - 2, 1), sheetFlow.Cells(bottomRow, rightColForFlow)).Delete (xlShiftUp)
  
  
  
  
        '—ƒ≈Ћ ј
        For Each temp In sheetSdelka.UsedRange
            If InStr(temp.Formula, tempStr) <> 0 Then
                 Set leftTopCell = temp
                 Exit For
            End If
        Next temp
         
         Set temp = leftTopCell
         
         Do While temp.Value = leftTopCell.Value
             Set temp = temp.Offset(1, 0)
         Loop
         
         bottomRow = temp.Row - 1
         
         sheetSdelka.Range(sheetSdelka.Cells(leftTopCell.Row, 1), sheetSdelka.Cells(bottomRow, 1)).EntireRow.Delete
        Set rightCell = rightCell.Offset(1, 0)
  Loop
  
  
  
   ''''''''''
   sheetBrief.Shapes("Add_Region_Button1").Delete
   sheetBrief.Shapes("Delete_Brand_Button1").Delete
   
   sheetBrief.Range(rightCellBase, rightCellBase.Offset(50, 6)).Clear
   For Each temp In FindMergedCells(sheetBrief.Range(rightCellBase, rightCellBase.Offset(50, 6)))
       temp.UnMerge
   Next temp
   Dim hh, i As Long
   For i = 1 To intLinesNr
       If CodeMod.Find("Sub Add_Region1", i, 1, -1, -1) Then
           CodeMod.deletelines i, 38
           Exit For
       End If
       i = i + 1
   Next
End Sub

