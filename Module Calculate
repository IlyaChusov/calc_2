        Next temp
        Set tcppCell = sheetFlow.UsedRange.Find(What:="TCPP", After:=tcppCell, LookIn:=xlValues, LookAt:=xlWhole, SearchOrder:=xlByRows, SearchDirection:=xlNext, MatchCase:=False)
