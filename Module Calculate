ErrorExit:
    errMsg = Err.Description & vbNewLine & vbNewLine & "Line: " & CStr(Erl)
    Resume CleanExit
End Sub

Sub correctBrokeFormula(sheet As Worksheet, ByRef cell As Range, ByRef cellToCopy As Range, rangeToFill As Range, coll As Collection)
    Dim tempStr As String, i As Long
    i = 1
    If cellToCopy Is Nothing Then
        With cell
            tempStr = .Formula
            
            Do While InStr(tempStr, "#REF") <> 0
                tempStr = Replace(tempStr, "#REF!", coll(i), 1, 1)
                i = i + 1
                If i > coll.Count Then i = 1
            Loop
            .Formula = tempStr
        End With
        Set cellToCopy = cell
    Else
        cellToCopy.Copy cell
    End If
    cell.AutoFill rangeToFill

End Sub

Sub speedUpMacros(yes As Boolean)
    Dim temp As Worksheet
    With Application
        If yes Then
            .Calculation = xlManual
            .ScreenUpdating = False
            .EnableEvents = False
        Else
            .Calculate
            .Calculation = xlAutomatic
            .ScreenUpdating = True
            .EnableEvents = True
        End If
    End With
    
    For Each temp In ActiveWorkbook.Worksheets
        temp.EnableCalculation = Not yes
        temp.EnableFormatConditionsCalculation = Not yes
    Next temp
End Sub

Private Function FindRequiredCell(searchRange As Range, searchText As String, Optional lookAt As XlLookAt = xlPart, Optional lookIn As XlFindLookIn = xlValues) As Range
    Dim found As Range
    Set found = searchRange.Find(What:=searchText, LookIn:=lookIn, LookAt:=lookAt, SearchOrder:=xlByRows, SearchDirection:=xlNext, MatchCase:=False)
    If found Is Nothing Then
        Err.Raise vbObjectError + 1024, , "Ќе найдена €чейка """ & searchText & """ на листе " & searchRange.Worksheet.Name
    End If
    Set FindRequiredCell = found
End Function


